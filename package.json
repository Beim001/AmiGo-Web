{
  "name": "amigo-lite",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit && tsc --noEmit -p worker",
    "test": "node scripts/vitest.mjs run",
    "worker:dev": "wrangler dev --port 8787",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "vite build && wrangler deploy"
  },
  "dependencies": {
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/dancing-script": "^5.3.0",
    "@fontsource/pacifico": "^5.3.0",
    "@fontsource/satisfy": "^5.3.0",
    "@fontsource/yellowtail": "^5.3.0",
    "@fontsource/zcool-kuaile": "^5.3.0",
    "@google/genai": "^2.4.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "hono": "^4.13.18",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "simple-icons": "^16.37.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.5.1",
    "@cloudflare/workers-types": "^5.20261114.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "happy-dom": "^21.0.4",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.162.0"
  }
}
